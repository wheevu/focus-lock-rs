{
  "$schema": "../node_modules/@tauri-apps/cli/schema/capability.json",
  "identifier": "main-window",
  "description": "Permissions for the main focus-lock window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "shell:allow-open",
      "allow": ["https://*", "http://*", "file://*"]
    },
    {
      "identifier": "fs:allow-app-read-recursive"
    },
    {
      "identifier": "fs:allow-app-write-recursive"
    }
  ]
}
